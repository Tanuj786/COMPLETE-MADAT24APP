{
  "expo": {
    "name": "Madat24 Mechanic",
    "slug": "madat24-mechanic",
    "scheme": "madat24mechanic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.madat24.mechanic",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.madat24.mechanic",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Madat24 Mechanic needs camera to upload service photos",
        "NSPhotoLibraryUsageDescription": "Madat24 Mechanic needs gallery access to upload service photos",
        "NSLocationWhenInUseUsageDescription": "Madat24 Mechanic shares your live location with the customer during a job",
        "NSLocationAlwaysUsageDescription": "Madat24 Mechanic uses background location so customers can track your arrival",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Madat24 Mechanic to share your live location with the customer."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Madat24 Mechanic needs access to your photos",
          "cameraPermission": "Madat24 Mechanic needs camera to take service photos"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_URL": "https://complete-madat24app-1.onrender.com/api",
      "SENTRY_DSN": "",
      "router": {},
      "eas": {
        "projectId": "3f974b7b-de3a-4d66-b1ab-cfbfe3ea58ee"
      }
    },
    "owner": "sinsta"
  }
}
