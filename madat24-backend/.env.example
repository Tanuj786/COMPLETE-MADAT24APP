# ─── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────
# DEV value here is fine. PRODUCTION must replace with a real secret:
#   openssl rand -hex 64
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated allowlist for production. Empty = "*" (dev only).
# Example: CORS_ORIGIN=https://app.madat24.com,https://admin.madat24.com
CORS_ORIGIN=

# ─── Sentry (optional) ──────────────────────────────────────────
# Get a DSN at https://sentry.io. Leave blank to disable error reporting.
SENTRY_DSN=

# ─── Database ────────────────────────────────────────────────────
# Default = SQLite local file (zero-setup, perfect for dev on a laptop).
# For production, switch to PostgreSQL (Neon is free):
#   DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require"
# AND change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma,
# then run: npm run prisma:generate && npm run prisma:push
DATABASE_URL="file:./dev.db"

# ─── Email (Forgot Password OTP) ─────────────────────────────────
# Leave blank for dev mode (OTP is returned in API response and printed to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Madat24 <noreply@madat24.local>

# ─── SMS (Phone OTP) ─────────────────────────────────────────────
# Leave blank for dev mode (OTP printed to console). For prod, plug Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ─── Razorpay (Payments) ─────────────────────────────────────────
# Leave blank for dev mode (orders auto-succeed). For prod:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Cloudinary (Image hosting) ──────────────────────────────────
# Leave blank for dev mode (files saved to ./uploads and served from /uploads/...)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AI Automobile Assistant (Claude API) ────────────────────────
# Powers the in-app /(shared)/ai-assistant chatbot.
# Get a key at https://console.anthropic.com (a free $5 trial credit covers 1000s of queries).
# Leave blank to disable — the screen will show "AI Offline".
ANTHROPIC_API_KEY=
# Default model is fast + cheap. Other options: claude-sonnet-4-6 (smarter, slower, ~10x cost)
ANTHROPIC_MODEL=claude-haiku-4-5

# ─── Geo search radius for nearby mechanics ──────────────────────
NEARBY_RADIUS_KM=5
