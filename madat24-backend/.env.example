# Server
PORT=4000
NODE_ENV=development

# JWT
# Production: generate with `openssl rand -hex 64`
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRES_IN=30d

# CORS
# Development: empty means allow all origins.
# Production: use explicit app/admin origins, comma-separated.
CORS_ORIGIN=

# Database
# Production must use PostgreSQL.
# Example Neon/Supabase/Railway URL:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/madat24"

# Error reporting
SENTRY_DSN=

# Email / password reset OTP
# Signup OTP is disabled for the MVP. Configure SMTP later for real password-reset email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Madat24 <noreply@madat24.com>

# SMS OTP
# Signup SMS OTP is disabled for the MVP. Configure Twilio later if phone OTP is re-enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Payments
# For APK/demo testing without Razorpay, set ENABLE_DEMO_PAYMENTS=true.
# For real production payments, set Razorpay keys and keep ENABLE_DEMO_PAYMENTS=false.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ENABLE_DEMO_PAYMENTS=true

# Image hosting
# Production requires Cloudinary. Development falls back to local ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Automobile Assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Rate limits
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_JOBS_MAX=20

# Geo search radius for nearby mechanics
NEARBY_RADIUS_KM=10
